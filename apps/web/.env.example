# Copy to .env for local development. Never commit .env.

# The API the web app talks to. Alchemy sets this itself when it deploys.
VITE_SERVER_URL=http://localhost:3000

# Optional. Where website logos come from: your own Brandfetch client ID, or "off" for
# plain icons and no requests to Brandfetch. Defaults to the mima project's ID.
# VITE_BRANDFETCH_CLIENT_ID=
