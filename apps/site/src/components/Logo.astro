---
import {
	logoBox,
	markFacets,
	markGradients,
	whiteFacetOpacity,
	wordmark,
} from "@vauly/ui/lib/brand";

// The vauly mark and wordmark, from the artwork in @vauly/ui/lib/brand. The wordmark
// takes the text color; gradient ids are unique so the logo can appear twice on a page.
interface Props {
	class?: string;
	/** "white" for deep blue backgrounds, where the mark's deep facets would vanish. */
	tone?: "color" | "white";
}

const { class: className, tone = "color" } = Astro.props;
const id = `logo-${Math.random().toString(36).slice(2, 8)}`;
const facets = Object.keys(markFacets) as (keyof typeof markFacets)[];
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox={`${logoBox.x} ${logoBox.y} ${logoBox.width} ${logoBox.height}`}
	fill="none"
	role="img"
	aria-label="vauly"
	class={className}
>
	<defs>
		{
			facets.map((facet) => {
				const g = markGradients[facet];
				return (
					<linearGradient
						id={`${id}-${facet}`}
						x1={g.x1}
						y1={g.y1}
						x2={g.x2}
						y2={g.y2}
						gradientUnits="userSpaceOnUse"
					>
						{g.stops.map(([offset, color]) => (
							<stop offset={offset} stop-color={color} />
						))}
					</linearGradient>
				);
			})
		}
	</defs>
	{
		facets.map((facet) =>
			tone === "white" ? (
				<path d={markFacets[facet]} fill="#FFFFFF" fill-opacity={whiteFacetOpacity[facet]} />
			) : (
				<path d={markFacets[facet]} fill={`url(#${id}-${facet})`} />
			),
		)
	}
	<g fill="currentColor">
		{wordmark.map((d) => <path d={d} />)}
	</g>
</svg>
