---
import BrandIcon from "@/components/BrandIcon.astro";
import Icon from "@/components/Icon.astro";

import Heading from "./Heading.astro";
import Section from "./Section.astro";

const people = [
	{ initials: "AK", name: "Alex Kim", note: "You", role: "Owner" },
	{ initials: "RC", name: "Riley Chen", note: "Since March", role: "Admin" },
	{ initials: "JP", name: "Jordan Park", note: "Since August", role: "Member" },
];

const exposed = [
	{ name: "GitHub", brand: "Github", changed: "Unchanged for 214 days" },
	{
		name: "Stripe live key",
		brand: "Stripe",
		changed: "Unchanged for 61 days",
	},
	{ name: "Figma", brand: "Figma", changed: "Unchanged for 33 days" },
];

const points = [
	"Each vault key is sealed for each member. The server can't add anyone.",
	"Admins invite and grant access. Members just use it.",
	"When someone leaves, mima lists what they could open.",
];
---

<Section id="sharing">
	<div class="grid items-center gap-16 lg:grid-cols-2">
		<Heading
			label="Sharing"
			title="Share vaults,"
			quiet="not passwords."
			lead="And know exactly what to rotate when someone leaves."
		>
			<ul class="mt-3 flex flex-col gap-3">
				{
					points.map((point) => (
						<li class="text-copy text-fg-muted flex gap-3">
							<Icon name="check" weight="bold" class="text-brand mt-1 size-4 shrink-0" />
							{point}
						</li>
					))
				}
			</ul>
		</Heading>

		<div data-reveal class="relative pb-44">
			<!-- The vault and the people in it -->
			<div class="bg-surface shadow-float ring-line-subtle rounded-2xl ring-1 lg:mr-10">
				<div class="border-line-subtle flex items-center gap-3 border-b px-5 py-4">
					<span class="bg-brand-soft flex size-9 items-center justify-center rounded-lg">
						<span class="bg-brand size-2.5 rounded-full"></span>
					</span>
					<div class="flex flex-1 flex-col">
						<span class="text-copy text-fg font-medium">Engineering</span>
						<span class="text-label text-fg-subtle">18 items · 3 people</span>
					</div>
					<span class="text-label bg-surface text-fg shadow-pill flex items-center gap-1.5 rounded-full px-3 py-1.5">
						<Icon name="plus" class="size-3.5" />
						Give access
					</span>
				</div>
				<ul class="flex flex-col p-2 pb-12">
					{
						people.map((person) => (
							<li class="flex items-center gap-3 rounded-lg px-3 py-2.5">
								<span class="bg-surface-sunken text-micro text-fg-muted flex size-8 items-center justify-center rounded-full font-medium">
									{person.initials}
								</span>
								<div class="flex flex-1 flex-col">
									<span class="text-label text-fg">{person.name}</span>
									<span class="text-micro text-fg-subtle">{person.note}</span>
								</div>
								<span class="text-micro text-fg-muted bg-surface-sunken rounded-full px-2 py-0.5">{person.role}</span>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Someone who left, and what they could open -->
			<div class="bg-surface shadow-popover ring-line-subtle absolute right-0 bottom-0 left-6 rounded-2xl ring-1 sm:left-16 lg:-right-4">
				<div class="flex items-center gap-2.5 px-4 pt-4 pb-2">
					<span class="bg-warning-soft text-warning flex size-7 items-center justify-center rounded-full">
						<Icon name="user-minus" class="size-3.5" />
					</span>
					<span class="text-label text-fg flex-1">
						<span class="font-medium">Sam Lee left</span>
						<span class="text-fg-subtle"> · could open 3 items</span>
					</span>
				</div>
				<ul class="flex flex-col px-2 pb-2">
					{
						exposed.map((item) => (
							<li class="flex items-center gap-3 rounded-lg px-2 py-2">
								<span class="bg-surface shadow-pill text-fg flex size-7 items-center justify-center rounded-md">
									<BrandIcon brand={item.brand} class="size-3.5" />
								</span>
								<div class="flex min-w-0 flex-1 flex-col">
									<span class="text-label text-fg truncate">{item.name}</span>
									<span class="text-micro text-fg-subtle truncate">{item.changed}</span>
								</div>
								<span class="text-micro text-link flex items-center gap-1 font-medium">
									<Icon name="arrows-clockwise" class="size-3" />
									Change
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</Section>
