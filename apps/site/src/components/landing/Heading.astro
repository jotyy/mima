---
// A section's heading: a small label, the title with a quieter second half, and a lead.
interface Props {
	label: string;
	title: string;
	quiet?: string;
	lead?: string;
	center?: boolean;
}

const { label, title, quiet, lead, center = false } = Astro.props;
---

<div
	data-reveal
	class:list={[
		"flex min-w-0 flex-col gap-5",
		center ? "mx-auto max-w-3xl items-center text-center" : "max-w-2xl",
	]}
>
	<span class="text-label text-link flex items-center gap-2 font-medium">
		<!-- A round escutcheon with the keyhole cut through it. -->
		<svg aria-hidden="true" viewBox="0 0 16 16" class="text-brand size-3.5 shrink-0">
			<path
				fill="currentColor"
				fill-rule="evenodd"
				d="M8 0a8 8 0 1 0 0 16A8 8 0 1 0 8 0zm0 4.25a2.25 2.25 0 0 1 1.05 4.24L9.6 12H6.4l.55-3.51A2.25 2.25 0 0 1 8 4.25z"
			></path>
		</svg>
		{label}
	</span>
	<h2 class="text-title-sm sm:text-title text-fg text-balance">
		{title}
		{quiet && <span class="text-quiet block">{quiet}</span>}
	</h2>
	{lead && <p class="text-lead-sm text-fg-muted text-pretty">{lead}</p>}
	<slot />
</div>
