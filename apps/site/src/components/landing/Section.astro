---
// A band of the page, set apart by space alone.
interface Props {
	id?: string;
	/** A dark band, in either theme. */
	dark?: boolean;
	class?: string;
}

const { id, dark = false, class: className } = Astro.props;
---

<section id={id} class:list={["relative", dark && "px-2 sm:px-4"]}>
	<div class:list={[dark && "dark bg-frame text-fg ring-line-subtle rounded-3xl ring-1"]}>
		<div class="mx-auto max-w-6xl px-6">
			<div class:list={["py-24 sm:px-10 sm:py-28", className]}>
				<slot />
			</div>
		</div>
	</div>
</section>
