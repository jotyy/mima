---
import Crossing from "./Crossing.astro";

// A band of the page: a hairline across the top, dots where it meets the guide lines.
interface Props {
	id?: string;
	/** The band's number in the margin, such as "02". */
	index?: string;
	class?: string;
}

const { id, index, class: className } = Astro.props;
---

<section id={id} class="border-line-subtle relative border-t">
	<Crossing index={index} />
	<div class="mx-auto max-w-6xl px-6">
		<div class:list={["py-24 sm:px-10 sm:py-32", className]}>
			<slot />
		</div>
	</div>
</section>
