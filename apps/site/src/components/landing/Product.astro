---
import { Picture } from "astro:assets";
import { CommandIcon, StackIcon, UsersThreeIcon } from "@phosphor-icons/react";

import items from "@/assets/screens/items.png";
import itemsDark from "@/assets/screens/items-dark.png";
import Heading from "./Heading.astro";
import Section from "./Section.astro";

const points = [
	{
		icon: UsersThreeIcon,
		title: "Vaults for every team",
		text: "A private vault for each person. Shared vaults for everything else.",
	},
	{
		icon: CommandIcon,
		title: "⌘K to anything",
		text: "Copy a password without opening it. The clipboard clears in 90 seconds.",
	},
	{
		icon: StackIcon,
		title: "Every kind of secret",
		text: "Logins with one-time codes, API keys, SSH keys and notes.",
	},
];
---

<Section id="product">
	<Heading
		center
		label="The app"
		title="Everything your team shares."
		quiet="In one calm place."
	/>

	<div data-reveal class="mt-16 sm:mt-20">
		<div class="bg-surface-sunken/70 ring-line-subtle rounded-3xl p-2 ring-1 sm:p-3">
			<div class="bg-surface shadow-float ring-line overflow-hidden rounded-2xl ring-1">
				<Picture
					src={items}
					formats={["avif", "webp"]}
					widths={[800, 1200, 1800, 2400]}
					sizes="(min-width: 72rem) 68rem, 100vw"
					alt="The Engineering vault in mima, with the AWS root login open: username, hidden password, a live one-time code and the website."
					class="block h-auto w-full dark:hidden"
				/>
				<Picture
					src={itemsDark}
					formats={["avif", "webp"]}
					widths={[800, 1200, 1800, 2400]}
					sizes="(min-width: 72rem) 68rem, 100vw"
					alt=""
					class="hidden h-auto w-full dark:block"
				/>
			</div>
		</div>
	</div>

	<div class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
		{
			points.map((point, index) => (
				<div data-reveal style={`--reveal-delay: ${index * 80}ms`} class="flex flex-col gap-2">
					<point.icon className="text-fg size-5" />
					<h3 class="text-copy text-fg mt-2 font-medium">{point.title}</h3>
					<p class="text-label text-fg-subtle text-pretty">{point.text}</p>
				</div>
			))
		}
	</div>
</Section>
