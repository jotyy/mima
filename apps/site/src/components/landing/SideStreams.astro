		brand: "Datadog",
		name: "Datadog",
		detail: "API key",
		cipher: "Rk3bM8qZ7cXu1f",
	},
];
---

<!-- One column in each margin, outside the guide lines, where there's room for it. -->
<div aria-hidden="true" class="wide:block pointer-events-none absolute inset-0 hidden">
	<div class="mx-auto h-full max-w-6xl px-6">
		<div class="relative h-full">
			<div data-slot="stream" class="absolute inset-y-0 right-full mr-5 w-40">
				<div data-slot="stream-track" style="--stream-duration: 60s">
					{[...items, ...items].map((item) => <ItemChip brand={item.brand} name={item.name} detail={item.detail} />)}
				</div>
			</div>
			<div data-slot="stream" class="absolute inset-y-0 left-full ml-5 w-40">
				<div data-slot="stream-track" data-reverse style="--stream-duration: 60s; animation-delay: -7s">
					{[...items, ...items].map((item) => <ItemChip brand={item.brand} name={item.name} cipher={item.cipher} />)}
				</div>
			</div>
		</div>
	</div>
</div>
