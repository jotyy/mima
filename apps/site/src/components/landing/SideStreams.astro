	{
		brand: "Github",
		name: "GitHub",
		detail: "alex@acme.example",
		cipher: "kX9fQ2Lq0vA7Tz",
	},
	{
		brand: "Stripe",
		name: "Stripe live key",
		detail: "API key",
		cipher: "U2Fs8dGVkX1eW4",
	},
	{
		brand: "Figma",
		name: "Figma",
		detail: "design@acme.example",
		cipher: "p0Rz8nWc4JdQ1m",
	},
	{
		brand: "Cloudflare",
		name: "Cloudflare token",
		detail: "API key",
		cipher: "f1Jw5uN9eL0oVx",
	},
	{
		brand: "Linear",
		name: "Linear",
		detail: "alex@acme.example",
		cipher: "Qw3oE7iU1yHs6b",
	},
	{
		brand: "Postgresql",
		name: "Postgres · staging",
		detail: "app",
		cipher: "m4Ls9Xa0Jf7TnR",
	},
	{
		brand: "Vercel",
		name: "Vercel",
		detail: "ops@acme.example",
		cipher: "Ze8cD1nR5qB2kP",
	},
	{
		brand: "Notion",
		name: "Notion",
		detail: "team@acme.example",
		cipher: "b6Nv2Kc8Ps4DwE",
	},
	{
		brand: "Docker",
		name: "Docker Hub",
		detail: "acmebot",
		cipher: "Yt2hG6vK4pWsL9",
	},
	{
		brand: "Sentry",
		name: "Sentry",
		detail: "ops@acme.example",
		cipher: "Gx5tR0wM3zLa8c",
	},
	{
		brand: "Supabase",
		name: "Supabase",
		detail: "service key",
		cipher: "Vn6sA0yP2gHkJ3",
