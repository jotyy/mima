---
import BrandIcon from "@/components/BrandIcon.astro";
import Icon from "@/components/Icon.astro";

import CipherField from "@/components/landing/CipherField.astro";
import EncryptDemo from "@/components/landing/EncryptDemo";
import { button, DEPLOY_URL, REPOSITORY } from "@/lib/ui";
---

<!--
	A sky in vauly blue, full of ciphertext that a keyhole reads as you move over it. The
	demo sits on the horizon under a frosted shackle, as the body of a lock.
-->
<section data-slot="hero-sky" class="pt-36 sm:pt-44">
	<CipherField />

	<div class="mx-auto max-w-6xl px-6 text-center">
		<a
			href={REPOSITORY}
			data-reveal
			class="text-label group inline-flex items-center gap-2 rounded-full bg-white/10 py-1 pr-3 pl-1 text-white/80 ring-1 ring-white/15 backdrop-blur-md transition hover:bg-white/15 hover:text-white"
		>
			<span class="flex items-center gap-1 rounded-full bg-white/15 px-2 py-0.5 font-medium text-white">
				<Icon name="github-logo" weight="fill" class="size-3.5" />
				Open source
			</span>
			AGPL-3.0
			<Icon name="arrow-right" class="size-3.5 transition-transform group-hover:translate-x-0.5" />
		</a>

		<h1
			data-reveal
			style="--reveal-delay: 60ms"
			class="text-display-sm sm:text-display mx-auto mt-7 max-w-4xl text-balance text-white"
		>
			The password manager
			<span class="text-sky-glow block">your team owns.</span>
		</h1>

		<p
			data-reveal
			style="--reveal-delay: 120ms"
			class="text-lead-sm sm:text-lead mx-auto mt-6 max-w-xl text-pretty text-white/75"
		>
			End-to-end encrypted passwords and keys for small teams and their agents.
			One click to deploy, on your own Cloudflare.
		</p>

		<div
			data-reveal
			style="--reveal-delay: 180ms"
			class="mt-9 flex flex-wrap items-center justify-center gap-3"
		>
			<a href={DEPLOY_URL} class={button("light", "lg", "group")}>
				<span aria-hidden="true"><BrandIcon brand="Cloudflare" /></span>
				Deploy to Cloudflare
				<Icon name="arrow-right" class="transition-transform group-hover:translate-x-0.5" />
			</a>
			<a href="/docs/" class={button("glass", "lg")}>Read the docs</a>
		</div>
	</div>

	<div
		data-reveal
		style="--reveal-delay: 260ms"
		class="relative mx-auto mt-24 max-w-5xl px-3 pb-16 sm:mt-36 sm:px-6 sm:pb-24"
	>
		<svg
			aria-hidden="true"
			viewBox="0 0 200 170"
			class="absolute -top-16 left-1/2 w-44 -translate-x-1/2 sm:-top-24 sm:w-60"
		>
			<defs>
				<linearGradient id="hero-shackle" x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="#fff" stop-opacity=".5"></stop>
					<stop offset="1" stop-color="#fff" stop-opacity=".06"></stop>
				</linearGradient>
				<linearGradient id="hero-shackle-edge" x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="#fff" stop-opacity=".9"></stop>
					<stop offset=".6" stop-color="#fff" stop-opacity="0"></stop>
				</linearGradient>
			</defs>
			<path d="M12 170V100a88 88 0 0 1 176 0v70" fill="none" stroke="url(#hero-shackle)" stroke-width="24"></path>
			<path d="M.75 170V100a99.25 99.25 0 0 1 198.5 0v70" fill="none" stroke="url(#hero-shackle-edge)" stroke-width="1.5"></path>
			<path d="M23.25 170V100a76.75 76.75 0 0 1 153.5 0v70" fill="none" stroke="url(#hero-shackle-edge)" stroke-opacity=".45" stroke-width="1.5"></path>
		</svg>
		<div class="relative rounded-2xl bg-white/15 p-1.5 ring-1 ring-white/30 backdrop-blur-md">
			<EncryptDemo client:visible />
		</div>
	</div>
</section>
