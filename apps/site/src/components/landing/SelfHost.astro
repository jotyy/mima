---
import { CheckCircleIcon } from "@phosphor-icons/react";

import Heading from "./Heading.astro";
import Section from "./Section.astro";

const steps = [
	{
		title: "Get the code",
		code: "git clone https://github.com/jotyy/mima && bun install",
	},
	{ title: "Connect Cloudflare", code: "bunx alchemy profile edit" },
	{ title: "Deploy", code: "bunx alchemy deploy --stage production" },
	{
		title: "Claim it",
		text: "Open the setup link, create your workspace, invite your team.",
	},
];

const created = [
	{ name: "database", what: "D1" },
	{ name: "server", what: "Worker" },
	{ name: "web", what: "Worker" },
];
---

<Section id="self-host">
	<div class="grid items-center gap-16 lg:grid-cols-2">
		<Heading
			label="Self-hosting"
			title="Yours in ten minutes."
			quiet="On your own Cloudflare."
			lead="No mima cloud, no account with us. A small team fits in Cloudflare's free plan."
		>
			<ol class="mt-3 flex flex-col gap-5">
				{
					steps.map((step, index) => (
						<li class="flex gap-4">
							<span class="text-micro text-fg-muted ring-line flex size-6 shrink-0 items-center justify-center rounded-full font-medium tabular-nums ring-1">
								{index + 1}
							</span>
							<div class="flex min-w-0 flex-1 flex-col gap-2">
								<span class="text-copy text-fg font-medium">{step.title}</span>
								{step.code ? (
									<code class="text-micro bg-surface text-fg-muted shadow-pill w-fit max-w-full truncate rounded-md px-2.5 py-1.5 font-mono">
										{step.code}
									</code>
								) : (
									<span class="text-label text-fg-subtle">{step.text}</span>
								)}
							</div>
						</li>
					))
				}
			</ol>
			<a href="/docs/self-hosting/" class="text-label text-link mt-2 w-fit pl-10 font-medium underline-offset-4 hover:underline">
				The full guide →
			</a>
		</Heading>

		<div data-reveal class="bg-terminal text-label text-terminal-fg shadow-float overflow-hidden rounded-2xl font-mono ring-1 ring-black/40">
			<div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
				<span class="size-2.5 rounded-full bg-white/15"></span>
				<span class="size-2.5 rounded-full bg-white/15"></span>
				<span class="size-2.5 rounded-full bg-white/15"></span>
				<span class="text-micro ml-2 text-white/60">~/mima/packages/infra</span>
			</div>
			<div class="flex flex-col gap-2 p-6 leading-relaxed">
				<span><span class="text-terminal-faint">$</span> bunx alchemy deploy --stage production</span>
				{
					created.map((row) => (
						<span class="flex gap-3">
							<CheckCircleIcon weight="fill" className="text-terminal-ok mt-1 size-3.5 shrink-0" />
							<span class="w-20">{row.name}</span>
							<span class="text-terminal-dim">{row.what} · mima-{row.name}-production</span>
						</span>
					))
				}
				<span class="text-terminal-dim mt-3">Your mima is ready:</span>
				<span class="text-terminal-link">https://mima.acme.example/setup?code=…</span>
			</div>
		</div>
	</div>
</Section>
