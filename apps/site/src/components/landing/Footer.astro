---
import { DesktopIcon, MoonIcon, SunIcon } from "@phosphor-icons/react";

import Logo from "@/components/Logo.astro";
import { REPOSITORY } from "@/lib/ui";

const themes = [
	{ value: "light", label: "Light", icon: SunIcon },
	{ value: "auto", label: "System", icon: DesktopIcon },
	{ value: "dark", label: "Dark", icon: MoonIcon },
];

const columns = [
	{
		title: "Product",
		links: [
			{ label: "Overview", href: "/#product" },
			{ label: "Agents", href: "/#agents" },
			{ label: "Browser extension", href: "/docs/browser-extension/" },
			{ label: "Security", href: "/#security" },
		],
	},
	{
		title: "Docs",
		links: [
			{ label: "Introduction", href: "/docs/" },
			{ label: "Self-hosting", href: "/docs/self-hosting/" },
			{ label: "Agents and scripts", href: "/docs/agents/" },
			{ label: "Security model", href: "/docs/security/" },
		],
	},
	{
		title: "Project",
		links: [
			{ label: "GitHub", href: REPOSITORY },
			{ label: "Changelog", href: `${REPOSITORY}/blob/main/CHANGELOG.md` },
			{
				label: "Report a vulnerability",
				href: `${REPOSITORY}/blob/main/SECURITY.md`,
			},
			{ label: "License (AGPL-3.0)", href: `${REPOSITORY}/blob/main/LICENSE` },
		],
	},
];
---

<footer class="border-line-subtle border-t">
	<div class="mx-auto max-w-6xl px-6">
		<div class="grid gap-12 py-16 sm:grid-cols-2 sm:px-10 lg:grid-cols-5">
		<div class="flex flex-col gap-4 lg:col-span-2">
			<a href="/" class="text-fg w-fit" aria-label="mima home"><Logo class="h-7 w-auto" /></a>
			<p class="text-label text-fg-subtle max-w-xs text-pretty">
				A self-hosted, end-to-end encrypted password manager for small teams and their
				agents.
			</p>
		</div>
		{
			columns.map((column) => (
				<nav aria-label={column.title} class="flex flex-col gap-3">
					<h2 class="text-label text-fg font-medium">{column.title}</h2>
					{column.links.map((link) => (
						<a href={link.href} class="text-label text-fg-subtle hover:text-fg w-fit transition-colors">
							{link.label}
						</a>
					))}
				</nav>
			))
		}
		</div>
	</div>
	<div class="border-line-subtle border-t">
			<div class="mx-auto max-w-6xl px-6">
			<div class="text-micro text-fg-faint flex flex-wrap items-center justify-between gap-3 py-6 sm:px-10">
				<span>Made for teams of a handful. Open source under AGPL-3.0.</span>
				<div
					role="radiogroup"
					aria-label="Theme"
					data-theme-switch
					class="bg-surface-sunken flex items-center gap-0.5 rounded-full p-0.5"
				>
					{
						themes.map((theme) => (
							<button
								type="button"
								role="radio"
								aria-checked="false"
								aria-label={theme.label}
								title={theme.label}
								data-value={theme.value}
								class="text-fg-subtle hover:text-fg aria-checked:bg-surface aria-checked:text-fg aria-checked:shadow-pill flex size-7 items-center justify-center rounded-full transition-colors outline-none focus-visible:ring-2 focus-visible:ring-brand"
							>
								<theme.icon className="size-3.5" />
							</button>
						))
					}
				</div>
			</div>
		</div>
	</div>
</footer>

<script>
	// The same setting the docs keep: "light", "dark", or nothing to follow the system.
	const KEY = "starlight-theme";
	const system = matchMedia("(prefers-color-scheme: dark)");
	const stored = () => {
		try {
			return localStorage.getItem(KEY) || "auto";
		} catch {
			return "auto";
		}
	};
	const apply = () => {
		const choice = stored();
		const dark = choice === "dark" || (choice === "auto" && system.matches);
		document.documentElement.classList.toggle("dark", dark);
		document.documentElement.dataset.theme = dark ? "dark" : "light";
		for (const button of document.querySelectorAll<HTMLElement>("[data-theme-switch] [data-value]"))
			button.setAttribute("aria-checked", String(button.dataset.value === choice));
	};
	for (const button of document.querySelectorAll<HTMLElement>("[data-theme-switch] [data-value]")) {
		button.addEventListener("click", () => {
			try {
				if (button.dataset.value === "auto") localStorage.removeItem(KEY);
				else localStorage.setItem(KEY, button.dataset.value ?? "");
			} catch {
				// Private windows may refuse storage; the choice still applies to this page.
			}
			apply();
		});
	}
	system.addEventListener("change", apply);
	apply();
</script>
