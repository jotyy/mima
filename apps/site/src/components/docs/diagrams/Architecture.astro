---
import Icon from "@/components/Icon.astro";

// What a deploy makes, and who talks to it: the web app, the extension and vauly run on
// the left, everything encrypted there; your Cloudflare account on the right, holding
// only ciphertext. The drawn version of the diagram in docs/self-hosting.md.

const clients = [
	{ icon: "browser", name: "The web app", note: "in your browser" },
	{
		icon: "puzzle-piece",
		name: "The extension",
		note: "fills and saves logins",
	},
	{
		icon: "terminal-window",
		name: "vauly run",
		note: "for agents and scripts",
	},
];
---

<figure class="architecture not-content" aria-label="What a deploy creates and what talks to it">
	<div class="clients">
		<span class="lane">Your devices</span>
		{
			clients.map((client) => (
				<div class="node">
					<span class="tile"><Icon name={client.icon} /></span>
					<span class="text"><strong>{client.name}</strong><span>{client.note}</span></span>
				</div>
			))
		}
	</div>

	<div class="link" aria-hidden="true">
		<span class="line"></span>
		<span class="seal"><Icon name="lock-simple" weight="bold" /></span>
		<span class="label">HTTPS, ciphertext only</span>
	</div>

	<div class="account">
		<span class="lane"><Icon name="cloud" /> Your Cloudflare account</span>
		<div class="node">
			<span class="tile"><Icon name="globe" /></span>
			<span class="text"><strong>vauly</strong><span>Worker · the app and its API</span></span>
		</div>
		<div class="down" aria-hidden="true"></div>
		<div class="node">
			<span class="tile"><Icon name="database" /></span>
			<span class="text"><strong>database</strong><span>D1 · items as ciphertext</span></span>
		</div>
	</div>
</figure>

<style>
	.architecture {
		--lock: #1f5bf9;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 6rem minmax(0, 1fr);
		align-items: center;
		margin-block: 1.75rem;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.875rem;
		background: var(--surface);
		font-size: 0.8125rem;
	}

	.clients,
	.account {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.account {
		padding: 0.875rem;
		border: 1px dashed color-mix(in srgb, var(--lock) 45%, transparent);
		border-radius: 0.75rem;
		background: var(--surface-sunken);
	}

	.lane {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-bottom: 0.25rem;
		color: var(--fg-subtle);
		font-size: 0.75rem;
	}

	.node {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.5rem 0.75rem 0.5rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 0.625rem;
		background: var(--surface);
	}

	.tile {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--lock) 10%, var(--surface));
		color: var(--lock);
	}

	.architecture :global(svg) {
		width: 0.9375rem;
		height: 0.9375rem;
	}

	.text {
		display: flex;
		min-width: 0;
		flex-direction: column;
		line-height: 1.35;
	}

	.text strong {
		color: var(--fg);
		font-weight: 500;
	}

	.text span {
		color: var(--fg-subtle);
		font-size: 0.75rem;
	}

	/* From the devices into the account, sealed on the way. */
	.link {
		position: relative;
		display: flex;
		height: 100%;
		align-items: center;
		justify-content: center;
	}

	.line {
		position: absolute;
		inset-inline: 0.5rem;
		top: 50%;
		height: 1px;
		background: color-mix(in srgb, var(--lock) 45%, transparent);
	}

	.line::after {
		content: "";
		position: absolute;
		top: -3px;
		right: 0;
		border: 3.5px solid transparent;
		border-left: 6px solid color-mix(in srgb, var(--lock) 70%, transparent);
		border-right: 0;
	}

	.seal {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 999px;
		background: var(--lock);
		color: #fff;
		box-shadow: 0 0 0 4px var(--surface);
	}

	.seal :global(svg) {
		width: 0.75rem;
		height: 0.75rem;
	}

	.label {
		position: absolute;
		top: calc(50% + 1.25rem);
		width: 100%;
		color: var(--fg-faint);
		font-size: 0.6875rem;
		line-height: 1.3;
		text-align: center;
	}

	.down {
		width: 1px;
		height: 0.75rem;
		margin: -0.25rem 0 -0.25rem 1.5rem;
		background: var(--line-strong);
	}

	@media (width < 40rem) {
		.architecture {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.link {
			height: 3.5rem;
		}

		.line {
			inset-inline: auto;
			left: 50%;
			top: 0;
			bottom: 0;
			width: 1px;
			height: auto;
		}

		.line::after {
			display: none;
		}

		.label {
			top: auto;
			left: calc(50% + 1.25rem);
			width: auto;
			text-align: start;
		}
	}
</style>
