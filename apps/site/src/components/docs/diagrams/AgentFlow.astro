---
import Icon from "@/components/Icon.astro";

// How a command gets a secret through vauly run, in four steps. The drawn version of the
// diagram in docs/agents.md.

const steps = [
	{
		icon: "robot",
		title: "The agent runs",
		code: "vauly run -- npm test",
		note: "Its .env holds vauly:// references.",
	},
	{
		icon: "cloud",
		title: "vauly asks",
		code: null,
		note: "your server for the item, as ciphertext.",
	},
	{
		icon: "check-circle",
		title: "A person allows it",
		code: null,
		note: "in vauly: once, or for an hour.",
	},
	{
		icon: "eye-slash",
		title: "The command runs",
		code: "DATABASE_URL=<hidden>",
		note: "With the value, decrypted on that machine and masked in the output.",
	},
];
---

<figure class="agent-flow not-content" aria-label="How a command gets a secret through vauly run">
	<ol>
		{
			steps.map((step, index) => (
				<li>
					<span class="number">{index + 1}</span>
					<span class="tile"><Icon name={step.icon} /></span>
					<strong>{step.title}</strong>
					{step.code && <code>{step.code}</code>}
					<span class="note">{step.note}</span>
				</li>
			))
		}
	</ol>
</figure>

<style>
	.agent-flow {
		--lock: #1f5bf9;
		margin-block: 1.75rem;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.875rem;
		background: var(--surface-sunken);
		font-size: 0.8125rem;
	}

	ol {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		margin: 0;
		padding: 0.875rem;
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		background: var(--surface);
	}

	/* An arrow to the next step. */
	li:not(:last-child)::after {
		content: "";
		position: absolute;
		top: 1.75rem;
		right: -1.125rem;
		width: 0.75rem;
		height: 1px;
		background: color-mix(in srgb, var(--lock) 55%, transparent);
	}

	.number {
		position: absolute;
		top: 0.875rem;
		right: 0.875rem;
		color: var(--fg-faint);
		font-family: var(--font-code);
		font-size: 0.6875rem;
	}

	.tile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		margin-bottom: 0.25rem;
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--lock) 10%, var(--surface));
		color: var(--lock);
	}

	.tile :global(svg) {
		width: 0.9375rem;
		height: 0.9375rem;
	}

	strong {
		color: var(--fg);
		font-weight: 500;
	}

	code {
		width: fit-content;
		max-width: 100%;
		padding: 0.125rem 0.375rem;
		border-radius: 0.375rem;
		background: var(--surface-sunken);
		color: var(--fg-muted);
		font-family: var(--font-code);
		font-size: 0.6875rem;
		overflow-wrap: anywhere;
	}

	.note {
		color: var(--fg-subtle);
		font-size: 0.75rem;
		line-height: 1.4;
	}

	@media (width < 48rem) {
		ol {
			grid-template-columns: 1fr 1fr;
		}

		li:nth-child(2)::after {
			display: none;
		}
	}

	@media (width < 30rem) {
		ol {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		li::after {
			display: none;
		}
	}
</style>
