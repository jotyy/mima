---
import Agents from "@/components/landing/Agents.astro";
import Details from "@/components/landing/Details.astro";
import Extension from "@/components/landing/Extension.astro";
import Faq from "@/components/landing/Faq.astro";
import FinalCta from "@/components/landing/FinalCta.astro";
import Footer from "@/components/landing/Footer.astro";
import Hero from "@/components/landing/Hero.astro";
import Nav from "@/components/landing/Nav.astro";
import Product from "@/components/landing/Product.astro";
import Security from "@/components/landing/Security.astro";
import SelfHost from "@/components/landing/SelfHost.astro";
import Sharing from "@/components/landing/Sharing.astro";
import Landing from "@/layouts/Landing.astro";
import { questions } from "@/lib/faq";

const description =
	"End-to-end encrypted logins, API keys and SSH keys for small teams and their agents. Open source, self-hosted on your own Cloudflare in one click.";
const home = new URL("/", Astro.site).href;

// What search engines and AI answers read about vauly, beyond the words on the page.
const data = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${home}#website`,
			url: home,
			name: "vauly",
			description,
			inLanguage: "en",
		},
		{
			"@type": "SoftwareApplication",
			"@id": `${home}#software`,
			name: "vauly",
			url: home,
			description,
			applicationCategory: "SecurityApplication",
			applicationSubCategory: "Password manager",
			operatingSystem: "Web",
			image: new URL("/social/home.jpg", Astro.site).href,
			license: "https://www.gnu.org/licenses/agpl-3.0.html",
			isAccessibleForFree: true,
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
			softwareHelp: {
				"@type": "CreativeWork",
				url: new URL("/docs/", Astro.site).href,
			},
			sameAs: ["https://github.com/jotyy/vauly"],
		},
		{
			"@type": "FAQPage",
			"@id": `${home}#faq`,
			mainEntity: questions.map(({ q, a }) => ({
				"@type": "Question",
				name: q,
				acceptedAnswer: { "@type": "Answer", text: a },
			})),
		},
	],
};
---

<Landing title="vauly: the open-source password manager your team owns" description={description}>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(data).replaceAll("<", "\\u003c")}
	/>
	<div class="relative isolate">
		<Nav />
		<main>
			<Hero />
			<Product />
			<Sharing />
			<Agents />
			<Extension />
			<Details />
			<Security />
			<SelfHost />
			<Faq />
			<FinalCta />
		</main>
		<Footer />
	</div>
</Landing>
