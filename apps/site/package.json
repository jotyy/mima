{
	"name": "site",
	"version": "0.0.0",
	"private": true,
	"description": "mima's website: the landing page and the docs.",
	"type": "module",
	"scripts": {
		"sync-docs": "bun scripts/sync-docs.ts",
		"dev": "bun scripts/sync-docs.ts && astro dev --port 4321",
		"build": "bun scripts/sync-docs.ts && astro build",
		"preview": "astro preview --port 4321",
		"check-types": "bun scripts/sync-docs.ts && astro check",
		"og": "bun scripts/og.ts"
	},
	"dependencies": {
		"@astrojs/react": "7.1.1",
		"@astrojs/starlight": "0.42.6",
		"@mima/crypto": "workspace:*",
		"@mima/ui": "workspace:*",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.4.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"simple-icons": "16.35.0",
		"tailwindcss": "catalog:"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "catalog:"
	}
}
