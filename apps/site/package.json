{
	"name": "site",
	"version": "0.0.0",
	"private": true,
	"description": "vauly's website: the landing page and the docs.",
	"type": "module",
	"scripts": {
		"sync-docs": "bun scripts/sync-docs.ts",
		"dev": "bun scripts/sync-docs.ts && astro dev --port 4321",
		"build": "bun scripts/sync-docs.ts && astro build",
		"preview": "astro preview --port 4321",
		"check-types": "bun scripts/sync-docs.ts && astro check",
		"og": "bun scripts/og.ts"
	},
	"dependencies": {
		"@astrojs/preact": "6.1.1",
		"@astrojs/starlight": "0.42.6",
		"@vauly/crypto": "workspace:*",
		"@vauly/ui": "workspace:*",
		"@phosphor-icons/core": "2.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.4.2",
		"preact": "11.0.1",
		"simple-icons": "16.35.0",
		"tailwindcss": "catalog:"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@playwright/test": "1.64.1",
		"typescript": "catalog:"
	}
}
