{
	"name": "mima",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"e2e"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"varlock": "1.18.0",
			"@cloudflare/workers-types": "^5.20260906.1",
			"@orpc/server": "^1.15.6",
			"@orpc/openapi": "^1.15.6",
			"@orpc/zod": "^1.15.6",
			"better-auth": "1.7.7",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.8",
			"@orpc/client": "^1.15.6",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev:bare -F web --",
		"dev:stack": "turbo run dev -F @mima/infra --",
		"db:generate": "turbo run db:generate -F @mima/db --",
		"deploy": "turbo run deploy -F @mima/infra --",
		"destroy": "turbo run destroy -F @mima/infra --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"check": "biome check --write .",
		"test": "bun test --cwd packages/crypto && bun test --cwd apps/cli && bun test --cwd apps/web",
		"test:e2e": "bun run --cwd e2e test"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/workers-types": "catalog:",
		"@mima/config": "workspace:*",
		"@types/node": "^26.4.1",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
